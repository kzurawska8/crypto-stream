# This is a COMMITTED TEMPLATE — placeholders only, no real secrets.
# Copy it to `.env` (git-ignored) and put real values there, then load it:
#   set -a; . ./.env; set +a      # then run: uv run crypto-stream
# IMPORTANT: wrap any value containing ';' or '$' in SINGLE quotes —
# e.g. the Event Hubs connection string and the literal $ConnectionString user.
# All values are optional; defaults shown.

# --- Data source (CoinGecko) ---
COINGECKO_API_URL=https://api.coingecko.com/api/v3
VS_CURRENCY=usd
# Comma-separated CoinGecko coin ids (see /coins/list for the full catalogue).
COINS=bitcoin,ethereum,solana,cardano,ripple,dogecoin

# --- Polling behaviour ---
POLL_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
# RUN_ONCE=true  -> fetch a single batch and exit (handy for testing/cron)
RUN_ONCE=false
LOG_LEVEL=INFO

# --- Sink: where records go ---
# stdout (default) | kafka
SINK=stdout
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=crypto.prices

# --- Auth: PLAINTEXT for local Kafka, SASL_SSL for Azure Event Hubs ---
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
#
# To point at Azure Event Hubs instead of local Kafka, set:
#   SINK=kafka
#   KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093
#   KAFKA_TOPIC=<your event hub name>
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_USERNAME=$ConnectionString
#   KAFKA_SASL_PASSWORD=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...

# --- Option: load the connection string from Azure Key Vault (Entra ID) ---
# If both are set, the secret from Key Vault REPLACES KAFKA_SASL_PASSWORD
# (so you can leave KAFKA_SASL_PASSWORD blank).
# KEYVAULT_URL=https://YOURVAULT.vault.azure.net/
# KEYVAULT_SECRET_NAME=eh-conn
#
# Key Vault auth — pick ONE:
#  (a) Local dev: run `az login` once, set nothing below.
#  (b) Service principal (app identity): set these three (CLIENT_SECRET is secret):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
